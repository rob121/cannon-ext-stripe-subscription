<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Sub\Component\Subscription\Administrator\Field">
  <fieldset>
    <field name="id" type="text" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC"/>
    <field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="2">JARCHIVED</option>
      <option value="-2">JTRASHED</option>
    </field>
    <field name="ordering"/>
    <field name="checked_out" type="hidden" filter="unset"/>
    <field name="checked_out_time" type="hidden" filter="unset"/>
    <field name="created_by" type="createdby" default="0" label="JGLOBAL_FIELD_CREATED_BY_LABEL" description="JGLOBAL_FIELD_CREATED_BY_DESC" hidden="true" hint="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_CREATED_BY"/>
    <field name="modified_by" type="modifiedby" default="0" label="JGLOBAL_FIELD_MODIFIED_BY_LABEL" description="JGLOBAL_FIELD_MODIFIED_BY_DESC" hidden="true" hint="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_MODIFIED_BY"/>
    <field name="user_id" type="user" label="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_USER_ID" description="COM_SUBSCRIPTION_FORM_DESC_SUBSCRIBER_USER_ID" hint="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_USER_ID"/>
    <field name="start_date" class="inputbox" format="%Y-%m-%d" timeformat="12" filter="server_utc" translateformat="false" showtime="false" singleheader="false" todaybutton="true" weeknumbers="false" filltable="false" type="calendar" required="true" label="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_START_DATE" description="COM_SUBSCRIPTION_FORM_DESC_SUBSCRIBER_START_DATE" hint="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_START_DATE"/>
    <field name="end_date" class="inputbox" format="%Y-%m-%d" timeformat="12" filter="server_utc" translateformat="false" showtime="false" singleheader="false" todaybutton="false" weeknumbers="false" filltable="false" type="calendar" required="true" message="End Date Required" label="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_END_DATE" description="COM_SUBSCRIPTION_FORM_DESC_SUBSCRIBER_END_DATE" hint="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_END_DATE"/>
    <field name="product_id" type="foreignkey" label="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_PRODUCT_ID" description="COM_SUBSCRIPTION_FORM_DESC_SUBSCRIBER_PRODUCT_ID" default="0" input_type="list" table="#__subscription_products" key_field="id" translate="true" value_field="name" fk_ordering="name ASC" hide_trashed="1" hide_unpublished="1" hide_archived="1"/>
    <field name="stripe_subscription_id" filter="safehtml" type="text" label="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_STRIPE_SUBSCRIPTION_ID" description="COM_SUBSCRIPTION_FORM_DESC_SUBSCRIBER_STRIPE_SUBSCRIPTION_ID" hint="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_STRIPE_SUBSCRIPTION_ID"/>
    <field name="stripe_subscription_secret" filter="safehtml" type="text" label="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_STRIPE_SUBSCRIPTION_SECRET" description="COM_SUBSCRIPTION_FORM_DESC_SUBSCRIBER_STRIPE_SUBSCRIPTION_SECRET" hint="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_STRIPE_SUBSCRIPTION_SECRET"/>
    <field name="stripe_customer_id" filter="safehtml" type="text" label="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_STRIPE_CUSTOMER_ID" description="COM_SUBSCRIPTION_FORM_DESC_SUBSCRIBER_STRIPE_CUSTOMER_ID" hint="COM_SUBSCRIPTION_FORM_LBL_SUBSCRIBER_STRIPE_CUSTOMER_ID"/>
    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
  </fieldset>
</form>
