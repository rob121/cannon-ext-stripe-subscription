<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Sub\Component\Subscription\Administrator\Field">
  <fieldset>
    <field name="id" type="text" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC"/>
    <field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="2">JARCHIVED</option>
      <option value="-2">JTRASHED</option>
    </field>
    <field name="ordering"/>
    <field name="checked_out" type="hidden" filter="unset"/>
    <field name="checked_out_time" type="hidden" filter="unset"/>
    <field name="created_by" type="createdby" default="0" label="JGLOBAL_FIELD_CREATED_BY_LABEL" description="JGLOBAL_FIELD_CREATED_BY_DESC" hidden="true" hint="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_CREATED_BY"/>
    <field name="modified_by" type="modifiedby" default="0" label="JGLOBAL_FIELD_MODIFIED_BY_LABEL" description="JGLOBAL_FIELD_MODIFIED_BY_DESC" hidden="true" hint="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_MODIFIED_BY"/>
    <field name="name" filter="safehtml" type="text" required="true" message="Name required" label="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_NAME" description="COM_SUBSCRIPTION_FORM_DESC_PRODUCT_NAME" hint="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_NAME"/>
    <field name="cost" filter="safehtml" type="number" required="true" message="Cost Required" label="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_COST" description="COM_SUBSCRIPTION_FORM_DESC_PRODUCT_COST" hint="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_COST"/>
    <field name="description" editor="|" buttons="false" filter="JComponentHelper::filterText" type="editor" required="true" message="Description Required" label="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_DESCRIPTION" description="COM_SUBSCRIPTION_FORM_DESC_PRODUCT_DESCRIPTION" hint="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_DESCRIPTION"/>
    <field name="period" default="monthly" type="list" required="true" label="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_PERIOD" description="COM_SUBSCRIPTION_FORM_DESC_PRODUCT_PERIOD" hint="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_PERIOD">
      <option value="weekly">COM_SUBSCRIPTION_PRODUCTS_PERIOD_OPTION_WEEKLY</option>
      <option value="monthly">COM_SUBSCRIPTION_PRODUCTS_PERIOD_OPTION_MONTHLY</option>
      <option value="quarterly">COM_SUBSCRIPTION_PRODUCTS_PERIOD_OPTION_QUARTERLY</option>
      <option value="annually">COM_SUBSCRIPTION_PRODUCTS_PERIOD_OPTION_ANNUALLY</option>
    </field>
    <field name="stripe_product_id" filter="safehtml" type="text" label="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_STRIPE_PRODUCT_ID" description="COM_SUBSCRIPTION_FORM_DESC_PRODUCT_STRIPE_PRODUCT_ID" hint="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_STRIPE_PRODUCT_ID"/>
    <field name="test_mode" type="checkbox" checked="" label="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_TEST_MODE" description="COM_SUBSCRIPTION_FORM_DESC_PRODUCT_TEST_MODE" hint="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_TEST_MODE"/>
    <field name="stripe_test_product_id" filter="safehtml" type="text" label="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_STIPE_TEST_PRODUCT_ID" description="COM_SUBSCRIPTION_FORM_DESC_PRODUCT_STIPE_TEST_PRODUCT_ID" hint="COM_SUBSCRIPTION_FORM_LBL_PRODUCT_STIPE_TEST_PRODUCT_ID"/>
    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
  </fieldset>
</form>
